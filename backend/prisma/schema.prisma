// Prisma schema for Plataforma de Planejamento e Gestão Financeira.
//
// Architectural note (PF -> PJ):
// Every financial record (accounts, categories, transactions, investments,
// goals, budgets) belongs to a `FinancialEntity`, not directly to a `User`.
// A User can own multiple entities. Today every user gets exactly one
// entity of type PF (Pessoa Física) on signup. A future Pessoa Jurídica
// module plugs in by (a) adding `PJ` usage of the same entity concept and
// (b) adding new models (AccountsPayable, AccountsReceivable, CashFlow,
// DreLine, ...) that reference FinancialEntity — without touching any of
// the models below. See /ARCHITECTURE.md for the full extension plan.
//
// Note on enums: SQLite (used for local dev) has no native enum type, so
// enum-like fields below are plain Strings. The allowed values are
// documented here and enforced by Zod schemas in src/modules/*/routes.ts.
// Switching `provider` to "postgresql" for production can optionally
// convert these back to real Prisma enums later without changing the data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "postgresql" for production; models below are portable.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// EntityType: "PF" | "PJ"
// AccountType: "CHECKING" (conta corrente) | "SAVINGS" (poupança) | "DIGITAL" | "CREDIT_CARD"
// TransactionType: "INCOME" | "EXPENSE"
// PaymentMethod: "PIX" | "CREDIT_CARD" | "DEBIT_CARD" | "BOLETO" | "TRANSFER" | "CASH"
// RecurrenceType: "NONE" | "WEEKLY" | "MONTHLY" | "YEARLY"
// ExpenseKind (expense categories only): "ESSENTIAL" | "LEISURE" | "EDUCATION" | "SHOPPING" | "FINANCIAL" | "INVESTMENT" | "OTHER"
// InvestmentClass: "FIXED_INCOME" (renda fixa) | "VARIABLE_INCOME" (renda variável) | "FUND" (fundos)
// InvestmentSubtype: "TESOURO_DIRETO" | "CDB" | "RDB" | "LCI" | "LCA" | "STOCK" | "FII" | "ETF" | "FUND" | "OTHER"
// InvestmentMovementType: "CONTRIBUTION" (aporte) | "WITHDRAWAL" (resgate) | "YIELD" (rendimento)
//
// Accounting obligations module (contador autônomo controlando o envio de
// obrigações mensais/anuais dos seus clientes PJ/MEI). This is deliberately
// scoped directly to `User` (the accountant), not to `FinancialEntity`: it
// tracks the accountant's professional practice (which client companies
// exist and which filings are due for each), not the accountant's own
// personal/business finances. See ARCHITECTURE.md.
//
// ClientRegime: "MEI" | "SIMPLES_NACIONAL"
// ObligationRecurrence: "MONTHLY" | "ANNUAL"

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  entities     FinancialEntity[]

  clients         Client[]
  obligationTypes ObligationType[]
}

model FinancialEntity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("PF") // EntityType
  createdAt DateTime @default(now())

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  investments  Investment[]
  goals        Goal[]
  budgets      Budget[]

  @@index([userId])
}

model Account {
  id       String          @id @default(cuid())
  entityId String
  entity   FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name        String
  type        String // AccountType
  institution String?

  initialBalanceCents Int @default(0)

  // Credit-card-only fields
  creditLimitCents Int?
  closingDay       Int? // day of month the invoice closes
  dueDay           Int? // day of month the invoice is due

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([entityId])
}

model Category {
  id       String          @id @default(cuid())
  entityId String
  entity   FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name        String
  type        String // TransactionType
  expenseKind String? // ExpenseKind
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  subcategories Subcategory[]
  transactions  Transaction[]
  budgets       Budget[]

  @@index([entityId])
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  transactions Transaction[]

  @@index([categoryId])
}

model Transaction {
  id       String          @id @default(cuid())
  entityId String
  entity   FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  type        String // TransactionType
  description String
  amountCents Int
  date        DateTime

  paymentMethod String // PaymentMethod

  recurrence        String    @default("NONE") // RecurrenceType
  recurrenceEndDate DateTime?

  // Credit card installments (parcelas) and recurring occurrences both use
  // this as a generic "series id" so every row belonging to the same
  // purchase/recurrence can be found and bulk-edited/deleted together.
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  // For credit card transactions: which invoice (YYYY-MM) this falls into.
  invoiceMonth String?

  notes     String?
  createdAt DateTime @default(now())

  @@index([entityId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([installmentGroupId])
}

model Investment {
  id       String          @id @default(cuid())
  entityId String
  entity   FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  class   String // InvestmentClass
  subtype String // InvestmentSubtype
  name    String
  broker  String?

  investedAmountCents Int
  currentAmountCents  Int

  purchaseDate DateTime
  maturityDate DateTime?
  rateInfo     String? // e.g. "CDI + 1.5%", "IPCA + 6%"
  notes        String?
  createdAt    DateTime @default(now())

  movements InvestmentMovement[]

  @@index([entityId])
}

model InvestmentMovement {
  id           String     @id @default(cuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  date         DateTime
  type         String // InvestmentMovementType
  amountCents  Int
  createdAt    DateTime   @default(now())

  @@index([investmentId])
}

model Goal {
  id       String          @id @default(cuid())
  entityId String
  entity   FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  name               String
  targetAmountCents  Int
  currentAmountCents Int       @default(0)
  targetDate         DateTime?
  createdAt          DateTime  @default(now())

  @@index([entityId])
}

model Budget {
  id       String          @id @default(cuid())
  entityId String
  entity   FinancialEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  month              String // "YYYY-MM"
  plannedAmountCents Int
  createdAt          DateTime @default(now())

  @@unique([categoryId, month])
  @@index([entityId, month])
}

model Client {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String // razão social / nome do cliente
  document String? // CNPJ ou CPF (MEI)
  regime   String // ClientRegime
  active   Boolean  @default(true)
  notes    String?
  createdAt DateTime @default(now())

  obligations ClientObligation[]

  @@index([userId])
}

// A obligation type is the *catalog* entry (ex.: "PGDAS-D", "DCTFWeb"),
// owned by the accountant so they can add/edit deadlines beyond the
// defaults seeded on signup, without any code change.
model ObligationType {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  recurrence String // ObligationRecurrence

  // MONTHLY: due date = (competence month + dueMonthOffset months), day dueDay.
  dueDay         Int @default(20)
  dueMonthOffset Int @default(1)

  // ANNUAL only: due date = (year, dueMonth, dueDay).
  dueMonth Int?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  clientObligations ClientObligation[]

  @@index([userId])
}

// Links a Client to an ObligationType they must file. `active` lets the
// accountant turn a filing off for a specific client (e.g. a MEI that
// doesn't file DCTFWeb) without deleting the catalog entry.
model ClientObligation {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  obligationTypeId String
  obligationType   ObligationType @relation(fields: [obligationTypeId], references: [id], onDelete: Cascade)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  completions ObligationCompletion[]

  @@unique([clientId, obligationTypeId])
  @@index([clientId])
}

// One row per period actually filed/sent. Absence of a row for a given
// competence means it's still pending — pending periods are computed on
// read, not pre-created, so nothing needs a scheduler/cron.
model ObligationCompletion {
  id                 String           @id @default(cuid())
  clientObligationId String
  clientObligation   ClientObligation @relation(fields: [clientObligationId], references: [id], onDelete: Cascade)

  competence     String // "YYYY-MM" (mensal) ou "YYYY" (anual)
  completedAt    DateTime @default(now())
  protocolNumber String?
  notes          String?

  @@unique([clientObligationId, competence])
  @@index([clientObligationId])
}
