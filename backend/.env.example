# SQLite is used by default for zero-setup local development.
# To run on PostgreSQL for production, change the datasource provider in
# prisma/schema.prisma from "sqlite" to "postgresql" and point this at a
# real database, e.g. postgresql://user:pass@host:5432/plataforma_financeira
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=3333
